# ==========================================
# CINEMA OS Enterprise Environment Variables
# ==========================================

# Database Persistence (PostgreSQL / Railway PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cinema_os?sslmode=prefer
REDIS_URL=redis://localhost:6379

# Clerk Authentication & Multi-Tenant Organization Management
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_clerk_key
CLERK_SECRET_KEY=sk_test_placeholder_clerk_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/simple/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/simple/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
CLERK_WEBHOOK_SECRET=whsec_placeholder

# S3-Compatible Encrypted Private Object Storage (Legal Contracts, PDF Call Sheets)
S3_ENDPOINT=https://s3.us-west-2.amazonaws.com
S3_REGION=us-west-2
S3_BUCKET_NAME=cinema-os-vault-production
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key

# Multi-Channel Dispatch & Notifications
EXPO_PUSH_ACCESS_TOKEN=your_expo_push_token
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM="CINEMA OS Dispatch <dispatch@cinema-os.com>"

# Meta WhatsApp Cloud API (Optional Direct Call Sheet Dispatch)
WHATSAPP_API_TOKEN=your_whatsapp_cloud_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# System Security & Encryption
ENCRYPTION_SECRET_KEY=generate_64_char_hex_random_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

