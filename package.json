{
  "name": "cinema-os-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CINEMA OS — Enterprise Film Industry Management & Production Operating System",
  "scripts": {
    "dev": "npm run dev --prefix apps/web",
    "build": "npm run build --prefix apps/web",
    "typecheck": "npm run typecheck --prefix apps/web",
    "mobile:start": "npm run start --prefix apps/mobile",
    "desktop:dev": "npm run dev --prefix apps/desktop"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  }
}

